{
  "name": "science-igcse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bilingual (EN-primary, ZH-scaffolded) interactive science courses for international curricula, starting with Cambridge IGCSE Physics 0625",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:content && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:syllabus": "tsx scripts/check-syllabus-coverage.ts",
    "check:content": "tsx scripts/check-content-integrity.ts && tsx scripts/check-syllabus-coverage.ts"
  },
  "dependencies": {
    "katex": "^0.16.27",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0",
    "uplot": "^1.6.32",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^3.2.6"
  }
}
